{
  "name": "source-code-print",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch": "node scripts/fetch-sheets.js",
    "fetch:images": "node scripts/fetch-images.js",
    "sync": "node scripts/fetch-sheets.js && node scripts/fetch-images.js",
    "check:updates": "node scripts/fetch-sheets.js --check-only",
    "check:updates:strict": "node scripts/fetch-sheets.js --check-only --fail-on-change"
  },
  "dependencies": {
    "astro": "^5.15.9"
  }
}
